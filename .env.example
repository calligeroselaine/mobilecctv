# Contact form email delivery — see README.md "Contact form setup".
# Without these, /api/contact returns a clear error instead of a fake success.

RESEND_API_KEY=
# Optional — defaults to Resend's shared sandbox sender if left blank.
# Set this to a verified sending address once a domain is verified in Resend.
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=sales@mobilecctvsolutions.com.au

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Set this in
# Vercel for the PRODUCTION environment only, then redeploy. Leave unset
# locally and in previews so they never count as real visits. Unset = off.
NEXT_PUBLIC_GA_ID=

# ---- Brevo (CRM + enquiry emails) — OFF until CONTACT_EMAIL_PROVIDER=brevo ----
# Leave CONTACT_EMAIL_PROVIDER unset (or "resend") and the form keeps working
# exactly as before through Resend. Set it to "brevo" only after Brevo has been
# tested; Resend then stays as a safety net until it is removed.
CONTACT_EMAIL_PROVIDER=
# Secret key from Mobile CCTV's OWN Brevo account (SMTP & API > API keys).
# Server-side only: never prefix with NEXT_PUBLIC_, never commit it.
BREVO_API_KEY=
# The address emails are sent from — must be on a domain authenticated in Brevo.
# Used for both the team notification and the customer acknowledgement.
# (Falls back to RESEND_FROM_EMAIL if blank.)
BREVO_SENDER_EMAIL=
# Optional: display name for those emails (default "Mobile CCTV Solutions").
BREVO_SENDER_NAME=
# Optional: only if the Brevo account has more than one pipeline — its name or id.
BREVO_DEAL_PIPELINE=
# Optional: starting stage name(s), comma separated, tried in order.
# Default is "New Enquiry,New" (Brevo's free plan names its first stage "New").
BREVO_DEAL_STAGE=
# The notification inbox is CONTACT_TO_EMAIL (above) — unchanged.

