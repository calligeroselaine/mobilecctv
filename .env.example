# Contact form email delivery — see README.md "Contact form setup".
# Without these, /api/contact returns a clear error instead of a fake success.

RESEND_API_KEY=
# Optional — defaults to Resend's shared sandbox sender if left blank.
# Set this to a verified sending address once a domain is verified in Resend.
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=sales@mobilecctvsolutions.com.au
